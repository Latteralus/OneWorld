{
  "name": "@oneworld/data-import-airports",
  "version": "0.1.0",
  "private": true,
  "description": "Import adapters that normalize external airport datasets into the canonical OneWorld airport model",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@oneworld/config": "workspace:*",
    "@oneworld/db": "workspace:*"
  },
  "devDependencies": {
    "@oneworld/testing": "workspace:*",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
