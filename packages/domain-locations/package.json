{
  "name": "@oneworld/domain-locations",
  "version": "0.1.0",
  "private": true,
  "description": "Player current location and location state constraints",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "seed": "tsx src/scripts/seed-cities.ts",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@oneworld/config": "workspace:*",
    "@oneworld/contracts": "workspace:*",
    "@oneworld/db": "workspace:*",
    "@oneworld/utils": "workspace:*",
    "drizzle-orm": "^0.38.3"
  },
  "devDependencies": {
    "@oneworld/testing": "workspace:*",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
