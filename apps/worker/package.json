{
  "name": "@oneworld/worker",
  "version": "0.1.0",
  "private": true,
  "description": "OneWorld background worker: recurring jobs, reconciliation, and outbox dispatch",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@oneworld/config": "workspace:*",
    "@oneworld/contracts": "workspace:*",
    "@oneworld/db": "workspace:*",
    "@oneworld/domain-airports": "workspace:*",
    "@oneworld/domain-employment": "workspace:*",
    "@oneworld/domain-finance": "workspace:*",
    "@oneworld/domain-housing": "workspace:*",
    "@oneworld/domain-passengers": "workspace:*",
    "@oneworld/domain-time": "workspace:*",
    "@oneworld/domain-training": "workspace:*",
    "@oneworld/domain-travel": "workspace:*",
    "@oneworld/domain-vehicles": "workspace:*"
  },
  "devDependencies": {
    "@oneworld/testing": "workspace:*",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
