{
  "name": "@oneworld/config",
  "version": "0.1.0",
  "private": true,
  "description": "Centralized, typed balance and environment configuration for OneWorld",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./load-dotenv": "./src/load-dotenv.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@oneworld/testing": "workspace:*",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
