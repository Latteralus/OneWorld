{
  "name": "oneworld",
  "version": "0.1.0",
  "private": true,
  "description": "OneWorld - persistent multiplayer aviation career and life-simulation platform",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "clean": "turbo run clean && rimraf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "db:generate": "pnpm --filter @oneworld/db generate",
    "db:migrate": "pnpm --filter @oneworld/db migrate",
    "db:studio": "pnpm --filter @oneworld/db studio",
    "world:import-airports": "pnpm --filter @oneworld/data-import-airports import-airports",
    "world:seed-cities": "pnpm --filter @oneworld/domain-locations seed",
    "world:seed-jobs": "pnpm --filter @oneworld/domain-employment seed",
    "changeset": "changeset",
    "prepare": "node -e \"if (!process.env.CI) { try { require('husky').install() } catch (e) {} }\""
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.11",
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.18.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^2.1.8"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,js,jsx,json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
