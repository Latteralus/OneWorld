{
  "name": "@oneworld/tracker",
  "version": "0.1.0",
  "private": true,
  "description": "OneWorld Windows desktop tracker: Electron tray app bridging MSFS/SimConnect to the cloud backend",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@oneworld/config": "workspace:*",
    "@oneworld/contracts": "workspace:*",
    "@oneworld/domain-telemetry": "workspace:*"
  },
  "devDependencies": {
    "@oneworld/testing": "workspace:*",
    "@types/node": "^22.10.5",
    "electron": "^33.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
