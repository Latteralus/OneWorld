{
  "name": "@oneworld/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Shared React UI primitives for the web and admin apps",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist .turbo"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@oneworld/testing": "workspace:*",
    "@types/react": "^19.0.2",
    "react": "^19.0.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
