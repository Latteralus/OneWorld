# -----------------------------------------------------------------------------
# OneWorld environment configuration
# Copy this file to .env, fill in real values, and never commit the real file.
# All variables are validated at startup via packages/config/src/env.ts
# -----------------------------------------------------------------------------

# --- Runtime -------------------------------------------------------------
NODE_ENV=development
APP_ENV=local

# --- Supabase / Postgres --------------------------------------------------
# Server-side connection string used by Drizzle migrations and the worker.
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Supabase project credentials (local `supabase start` defaults shown).
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# --- Web app ---------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MAP_TILE_PROVIDER=maplibre-demo
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json

# --- Admin app ---------------------------------------------------------------
ADMIN_APP_URL=http://localhost:3100
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# --- Worker ------------------------------------------------------------------
WORKER_POLL_INTERVAL_MS=5000
WORKER_LOCK_TTL_MS=60000

# --- Tracker / flight sessions ------------------------------------------------
TRACKER_JWT_SECRET=replace-with-a-long-random-string
TRACKER_MIN_SUPPORTED_VERSION=0.1.0
TRACKER_USE_MOCK_SIMCONNECT=true

# --- Feature flags (booleans, see packages/config/src/feature-flags.config.ts) -
FEATURE_PASSENGER_JOBS_ENABLED=true
FEATURE_GROUND_VEHICLE_FUEL_ENABLED=true
FEATURE_EMPLOYMENT_APPLICATIONS_ENABLED=true
FEATURE_INSTRUMENT_TRAINING_ENABLED=false
FEATURE_MULTI_ENGINE_ENABLED=false
FEATURE_AIRPORT_ACTIVITY_DECAY_ENABLED=true
FEATURE_TRACKER_PAYLOAD_LOCK_ENABLED=false

# --- Observability -------------------------------------------------------------
LOG_LEVEL=info
